# API keys for closed-API models. NEVER commit real values.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Gemini routes through OpenAI-compatible proxy (e.g. VSellm).
# Keep these blank to use real OpenAI/Anthropic endpoints.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Paths to our fine-tuned LoRA checkpoints
MOONDREAM_LORA_PATH=/path/to/checkpoints/moondream-lora-v22/adapter.pt
FLORENCE_LORA_PATH=/path/to/checkpoints/florence-v22
FLORENCE_LARGE_LORA_PATH=/path/to/checkpoints/florence-large-v22
